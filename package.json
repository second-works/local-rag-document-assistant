{
  "name": "local-rag-document-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Gemma 4 local RAG document search portfolio project",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "llm:proxy": "node --env-file-if-exists=.env.tunnel scripts/local-llm-auth-proxy.mjs",
    "tunnel:run": "cloudflared tunnel --config cloudflared/config.yml run local-rag-llm",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker:typecheck": "tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "worker:types": "wrangler types --strict-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "16.3.5",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "4.131.1"
  }
}
